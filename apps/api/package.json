{
  "name": "@razorpay-recovery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "simulate:failed": "tsx src/scripts/simulate-webhook.ts",
    "simulate:abandoned": "tsx src/scripts/simulate-abandoned.ts",
    "simulate:receivables": "tsx src/scripts/simulate-receivables.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/ollama": "^1.3.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.0",
    "ioredis": "^6.0.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.0",
    "resend": "^6.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
