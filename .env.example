DATABASE_URL=postgresql://user:password@localhost:5432/razorpay_recovery
REDIS_URL=redis://localhost:6379
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_api_key_secret_here
PORT=3000

# LLM provider: "claude", "ollama", or "gemini"
LLM_PROVIDER=claude
# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5
# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Gemini (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=AIzaXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.6-flash

# Frontend
VITE_API_URL=http://localhost:3000/api

# Split-origin deployments only: the public origin allowed to call the API
# (e.g. https://your-frontend.onrender.com). Leave unset for same-origin
# serving via the Vite dev proxy or the nginx /api reverse proxy.
# WEB_ORIGIN=https://your-frontend.onrender.com

# Message delivery (email via Resend). Leave RESEND_API_KEY unset to run in stub mode.
DELIVERY_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
DELIVERY_FROM_EMAIL=no-reply@yourdomain.com

# Compliance: quiet hours (24h, overnight wrap allowed) + per-recipient caps.
QUIET_HOURS_START=21
QUIET_HOURS_END=8
COMPLIANCE_TZ=Asia/Kolkata
COMPLIANCE_DAILY_CAP=1
COMPLIANCE_WEEKLY_CAP=3

# Escalations: default owner queue + SLA horizon in hours.
ESCALATION_OWNER=support-queue
ESCALATION_SLA_HOURS=48
